{
  "name": "promptnite-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "(curl -s -o /dev/null --retry 30 --retry-delay 1 --retry-connrefused http://127.0.0.1:8787/ &); wrangler dev --var STAY_CONNECTED:true",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.1"
  }
}
